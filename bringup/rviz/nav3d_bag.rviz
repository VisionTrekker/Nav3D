Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 549
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 255; 0
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.30000001192092896
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.029999999329447746
          Name: SLAM Trajectory
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose:
            Position:
              X: 0
              Y: 0
              Z: 0
            Orientation:
              X: 0
              Y: 0
              Z: 0
              W: 1
          Queue Size: 50
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic:
            Depth: 50
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /lio_mapping/path_topic_name
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 60; 60
          Color Transformer: FlatColor
          Decay Time: 0.30000001192092896
          Enabled: true
          Name: Current LIO Cloud
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.019999999552965164
          Style: Points
          Topic:
            Depth: 10
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /lio/mapping/clouds_lidar
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.800000011920929
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Name: Global Map
          Pose:
            Position:
              X: 0
              Y: 0
              Z: 0
            Orientation:
              X: 0
              Y: 0
              Z: 0
              W: 1
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /lio/mapping/global_map
          Use Fixed Frame: true
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: KDTree Markers
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /lio/mapping/ikdtree
          Value: true
      Enabled: true
      Name: Mapping / LIO
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Name: map_noelevator
          Position Transformer: XYZ
          Queue Size: 1
          Selectable: true
          Size (Pixels): 2
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /map_loader/pcd_points
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.699999988079071
          Class: octomap_rviz_plugins/OccupancyMap
          Enabled: true
          Name: map_noelevator_octomap
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /map_loader/octomap
          Value: true
        - Angle Tolerance: 0.10000000149011612
          Class: rviz_default_plugins/Odometry
          Color: 255; 214; 10
          Enabled: true
          Keep: 10
          Name: Localization Pose
          Position Tolerance: 0.10000000149011612
          Shape: Axes
          Topic:
            Depth: 10
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /lio/localization/odom
          Value: true
      Enabled: true
      Name: Localization
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 255; 0
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.30000001192092896
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.029999999329447746
          Name: Global Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose:
            Position:
              X: 0
              Y: 0
              Z: 0
            Orientation:
              X: 0
              Y: 0
              Z: 0
              W: 1
          Queue Size: 100
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_planner/path
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Local Optimized Trajectory
          Namespaces:
            {}
          Topic:
            Depth: 20
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /optimal_list
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 220; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Raw Occupancy Voxels
          Position Transformer: XYZ
          Queue Size: 5
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.05000000074505806
          Style: Boxes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /grid_map/occupancy
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.6000000238418579
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 80; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Name: Inflated Occupancy Voxels
          Position Transformer: XYZ
          Queue Size: 5
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.05000000074505806
          Style: Boxes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /grid_map/occupancy_inflate
          Use Fixed Frame: true
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Sliding Map Bounds
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /grid_map/sliding_map_bbox
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/PointCloud2
          Color: 80; 180; 255
          Color Transformer: FlatColor
          Decay Time: 0.20000000298023224
          Enabled: false
          Name: Planner Sensor Cloud
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.019999999552965164
          Style: Points
          Topic:
            Depth: 10
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /local_planner/sim_cloud
          Use Fixed Frame: true
          Value: true
      Enabled: true
      Name: Local Planner
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/TF
          Enabled: false
          Name: TF (all frames)
          Show Arrows: false
          Show Axes: false
          Show Names: false
          Tree:
            {}
          Update Interval: 0
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/Axes
          Enabled: false
          Length: 0.4000000059604645
          Name: Base Link Axes
          Radius: 0.029999999329447746
          Reference Frame: base_link
          Show Trail: false
          Value: true
      Enabled: true
      Name: Debug Frames
    - Class: rviz_default_plugins/InteractiveMarkers
      Enable Transparency: true
      Enabled: true
      Name: Goal Pose
      Show Description: true
      Show Visual Aids: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 50
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.785398006439209
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785398006439209
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: ""
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1200
  X: 526
  Y: 321
