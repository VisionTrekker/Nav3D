<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <ros2_control name="A1GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <xacro:macro name="a1_effort_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:a1_effort_joint joint_name="FR_hip_joint"/>
    <xacro:a1_effort_joint joint_name="FR_thigh_joint"/>
    <xacro:a1_effort_joint joint_name="FR_calf_joint"/>
    <xacro:a1_effort_joint joint_name="FL_hip_joint"/>
    <xacro:a1_effort_joint joint_name="FL_thigh_joint"/>
    <xacro:a1_effort_joint joint_name="FL_calf_joint"/>
    <xacro:a1_effort_joint joint_name="RR_hip_joint"/>
    <xacro:a1_effort_joint joint_name="RR_thigh_joint"/>
    <xacro:a1_effort_joint joint_name="RR_calf_joint"/>
    <xacro:a1_effort_joint joint_name="RL_hip_joint"/>
    <xacro:a1_effort_joint joint_name="RL_thigh_joint"/>
    <xacro:a1_effort_joint joint_name="RL_calf_joint"/>
  </ros2_control>
</robot>
